#include <stdio.h>

int main() {
    float moeda, total = 0;
    int opcao;

    do {
        printf("===== COFRINHO DIGITAL =====\n");
        printf("1 - Adicionar R$ 0,50\n");
        printf("2 - Adicionar R$ 1,00\n");
        printf("3 - Adicionar R$ 2,00\n");
        printf("0 - Parar e ver o total\n");

        printf("Escolha uma opcao: ");
        scanf("%d", &opcao);

        switch (opcao) {
            case 1:
                moeda = 0.50;
                total += moeda;
                printf("Moeda de R$ 0,50 adicionada!\n\n");
                break;

            case 2:
                moeda = 1.00;
                total += moeda;
                printf("Moeda de R$ 1,00 adicionada!\n\n");
                break;

            case 3:
                moeda = 2.00;
                total += moeda;
                printf("Moeda de R$ 2,00 adicionada!\n\n");
                break;

            case 0:
                printf("\nEncerrando o cofrinho...\n");
                break;

            default:
                printf("Opcao invalida! Tente novamente.\n\n");
        }

    } while (opcao != 0);

    printf("Total acumulado no cofrinho: R$ %.2f\n", total);

    return 0;
}
